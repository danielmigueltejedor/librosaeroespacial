Notebook[{
Cell["Pr\[AAcute]ctica 3. Cinem\[AAcute]tica de fluidos", "Title",ExpressionUUID->"0e9cb0d7-8d35-41c6-922a-39e80067b9a9"],

Cell["\<\
Mec\[AAcute]nica de Fluidos (ULE 0710311), segunda edici\[OAcute]n. Material \
original; se explica en la parte 7 del libro.\
\>", "Text",ExpressionUUID->"11edbdbc-da21-4f5e-a36d-d454e540db69"],

Cell[TextData[{
 "Eval\[UAcute]e las celdas en orden. Las figuras se exportan a la carpeta ",
 Cell["figures/", "InlineCode",ExpressionUUID->
  "1867e5ee-7cf7-41df-a2a7-d28f2c193d3d"],
 " junto al cuaderno."
}], "Text",ExpressionUUID->"8ef9a466-6152-48a6-b3a3-a9b9056fb033"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SetDirectory", "[", 
   RowBox[{"NotebookDirectory", "[", "]"}], "]"}], ";", " ", 
  RowBox[{"Quiet", "[", 
   RowBox[{"CreateDirectory", "[", "\"\<figures\>\"", "]"}], "]"}], 
  ";"}]], "Input",ExpressionUUID->"53d1940e-42d4-42cf-9927-8a0cec3ff779"],

Cell["Bloque A: de la funcion de corriente a la velocidad", "Chapter",ExpressionUUID->"96300ef5-5337-4aa8-8d96-b59857f6e51c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"K", " ", "=", " ", "1"}], ";"}], 
  "                                        ", 
  RowBox[{"(*", " ", 
   RowBox[{"1", "/", 
    RowBox[{"(", 
     RowBox[{"m", " ", "s"}], ")"}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"psi", " ", "=", " ", 
   RowBox[{"K", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"x", "^", "2"}], " ", "y"}], " ", "+", " ", 
      RowBox[{"2", " ", "x", " ", 
       RowBox[{"y", "^", "2"}]}]}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"vel", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{"psi", ",", " ", "y"}], "]"}], ",", " ", 
     RowBox[{"-", 
      RowBox[{"D", "[", 
       RowBox[{"psi", ",", " ", "x"}], "]"}]}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<A: velocidad = \>\"", ",", " ", "vel", ",", 
    " ", "\"\<, divergencia = \>\"", ",", " ", 
    RowBox[{"Simplify", "[", 
     RowBox[{"Div", "[", 
      RowBox[{"vel", ",", " ", 
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}]}], "]"}], "]"}]}], "]"}], 
  ";"}]}], "Input",ExpressionUUID->"f96157bc-2c42-4dea-a8ca-ea4fe6cfa37f"],

Cell["\<\
Bloque B: gradiente de velocidad, aceleracion, vorticidad y fuerza\
\>", "Chapter",ExpressionUUID->"1cf13c49-5465-4a9b-a5c4-f08af2d22395"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"gradV", " ", "=", " ", 
    RowBox[{"Grad", "[", 
     RowBox[{"vel", ",", " ", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "y"}], "}"}]}], "]"}]}], ";"}], 
  "                     ", 
  RowBox[{"(*", " ", 
   RowBox[{"matriz", " ", "d", " ", 
    RowBox[{"u_i", " ", "/", " ", "d"}], " ", "x_j"}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"acc", " ", "=", " ", 
    RowBox[{"Simplify", "[", 
     RowBox[{"gradV", " ", ".", " ", "vel"}], "]"}]}], ";"}], 
  "                   ", 
  RowBox[{"(*", " ", 
   RowBox[{"aceleracion", " ", "convectiva", " ", 
    RowBox[{"(", 
     RowBox[{"flujo", " ", "estacionario"}], ")"}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"vort", " ", "=", " ", 
    RowBox[{"Curl", "[", 
     RowBox[{"vel", ",", " ", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "y"}], "}"}]}], "]"}]}], ";"}], 
  "                      ", 
  RowBox[{"(*", " ", 
   RowBox[{"escalar", " ", "en", " ", "2", 
    RowBox[{"D", ":", " ", 
     RowBox[{
      RowBox[{"dv", "/", "dx"}], " ", "-", " ", 
      RowBox[{"du", "/", "dy"}]}]}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"lamb", " ", "=", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"Grad", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"vel", " ", ".", " ", "vel"}], ")"}], "/", "2"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "y"}], "}"}]}], "]"}], " ", "-", " ", 
     RowBox[{"vort", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"vel", "[", 
         RowBox[{"[", "2", "]"}], "]"}], ",", " ", 
        RowBox[{"-", 
         RowBox[{"vel", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}]}], "}"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<B: aceleracion = \>\"", ",", " ", 
    RowBox[{"Factor", "[", "acc", "]"}], ",", " ", "\"\<, vorticidad = \>\"", 
    ",", " ", "vort"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<B: forma de Lamb igual a la convectiva: \>\"", ",", " ", 
    RowBox[{"Simplify", "[", 
     RowBox[{"lamb", " ", "==", " ", "acc"}], "]"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"pt", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x", " ", "->", " ", "1"}], ",", " ", 
     RowBox[{"y", " ", "->", " ", "2"}]}], "}"}]}], ";", " ", 
  RowBox[{
   RowBox[{"{", "rho", "}"}], " ", "=", " ", 
   RowBox[{"{", "1000", "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<B: en (1,2): u = \>\"", ",", " ", 
    RowBox[{"vel", " ", "/.", " ", "pt"}], ",", " ", "\"\<, a = \>\"", ",", 
    " ", 
    RowBox[{"acc", " ", "/.", " ", "pt"}], ",", 
    " ", "\"\<, fuerza por unidad de volumen = \>\"", ",", " ", 
    RowBox[{
     RowBox[{"rho", " ", "acc"}], " ", "/.", " ", "pt"}], ",", 
    " ", "\"\<, modulo = \>\"", ",", " ", 
    RowBox[{"N", "[", 
     RowBox[{"Norm", "[", 
      RowBox[{
       RowBox[{"rho", " ", "acc"}], " ", "/.", " ", "pt"}], "]"}], "]"}]}], 
   "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<B: laplaciano de u = \>\"", ",", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"Laplacian", "[", 
       RowBox[{"#", ",", " ", 
        RowBox[{"{", 
         RowBox[{"x", ",", " ", "y"}], "}"}]}], "]"}], " ", "&"}], " ", "/@", 
     " ", "vel"}], ",", " ", "\"\< ; -rot(omega) = \>\"", ",", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"D", "[", 
        RowBox[{"vort", ",", " ", "y"}], "]"}]}], ",", " ", 
      RowBox[{"D", "[", 
       RowBox[{"vort", ",", " ", "x"}], "]"}]}], "}"}]}], "]"}], 
  ";"}]}], "Input",ExpressionUUID->"02b62f83-0bf8-418d-bb76-33b9e7baea88"],

Cell["Bloque C: visualizacion del campo y de las lineas psi = cte", "Chapter",ExpressionUUID->"8283b44b-5a27-4bc7-b296-9b5131d63a28"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"figC", " ", "=", " ", 
   RowBox[{"Show", "[", "\n", "   ", 
    RowBox[{
     RowBox[{"StreamPlot", "[", 
      RowBox[{"vel", ",", " ", 
       RowBox[{"{", 
        RowBox[{"x", ",", " ", 
         RowBox[{"-", "2"}], ",", " ", "2"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"y", ",", " ", 
         RowBox[{"-", "2"}], ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"StreamColorFunction", " ", "->", " ", "None"}], ",", " ", 
       RowBox[{"StreamStyle", " ", "->", " ", "Gray"}], ",", " ", 
       RowBox[{"StreamPoints", " ", "->", " ", "Coarse"}]}], "]"}], ",", "\n",
      "   ", 
     RowBox[{"ContourPlot", "[", 
      RowBox[{"psi", ",", " ", 
       RowBox[{"{", 
        RowBox[{"x", ",", " ", 
         RowBox[{"-", "2"}], ",", " ", "2"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"y", ",", " ", 
         RowBox[{"-", "2"}], ",", " ", "3"}], "}"}], ",", " ", 
       RowBox[{"Contours", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "6"}], ",", " ", 
          RowBox[{"-", "3"}], ",", " ", 
          RowBox[{"-", "1"}], ",", " ", "1", ",", " ", "3", ",", " ", "6", ",",
           " ", "10"}], "}"}]}], ",", " ", 
       RowBox[{"ContourShading", " ", "->", " ", "None"}], ",", " ", 
       RowBox[{"ContourStyle", " ", "->", " ", "Blue"}]}], "]"}], ",", "\n", 
     "   ", 
     RowBox[{"Graphics", "[", 
      RowBox[{"{", 
       RowBox[{"Red", ",", " ", 
        RowBox[{"PointSize", "[", "0.02", "]"}], ",", " ", 
        RowBox[{"Point", "[", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "2"}], "}"}], "]"}], ",", " ", 
        RowBox[{"Arrow", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"1", ",", " ", "2"}], "}"}], " ", "+", " ", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"acc", " ", "/.", " ", "pt"}], ")"}], "/", "150"}]}]}], 
          "}"}], "]"}]}], "}"}], "]"}], ",", "\n", "   ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<x (m)\>\"", ",", " ", "\"\<y (m)\>\""}], "}"}]}], ",", 
     " ", 
     RowBox[{"ImageSize", " ", "->", " ", "360"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Export", "[", 
   RowBox[{"\"\<figures/m03-corriente.png\>\"", ",", " ", 
    RowBox[{"Rasterize", "[", 
     RowBox[{"figC", ",", " ", 
      RowBox[{"Background", " ", "->", " ", "White"}], ",", " ", 
      RowBox[{"ImageResolution", " ", "->", " ", "72"}]}], "]"}]}], "]"}], 
  ";"}]}], "Input",ExpressionUUID->"93be256c-3a3e-4e87-8924-6a137f162357"],

Cell["\<\
Bloque D: lineas de corriente frente a trayectorias en un flujo no \
estacionario\
\>", "Chapter",ExpressionUUID->"e7b3b1d7-187a-48c8-8a20-dd8f8ddd2f1d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"u0", " ", "=", " ", "2"}], ";", " ", 
   RowBox[{"a", " ", "=", " ", "0.5"}], ";"}], 
  "                               ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"u", " ", "=", " ", "u0"}], ",", " ", 
    RowBox[{"v", " ", "=", " ", 
     RowBox[{"a", " ", "t", " ", 
      RowBox[{"(", 
       RowBox[{"capitulo", " ", "4"}], ")"}]}]}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"tray", " ", "=", " ", 
   RowBox[{"NDSolveValue", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"X", "'"}], "[", "t", "]"}], " ", "==", " ", "u0"}], ",", 
       " ", 
       RowBox[{
        RowBox[{
         RowBox[{"Y", "'"}], "[", "t", "]"}], " ", "==", " ", 
        RowBox[{"a", " ", "t"}]}], ",", " ", 
       RowBox[{
        RowBox[{"X", "[", "0", "]"}], " ", "==", " ", "0"}], ",", " ", 
       RowBox[{
        RowBox[{"Y", "[", "0", "]"}], " ", "==", " ", "0"}]}], "}"}], ",", 
     " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"X", "[", "t", "]"}], ",", " ", 
       RowBox[{"Y", "[", "t", "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"t", ",", " ", "0", ",", " ", "4"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<D: trayectoria en t = 4 s: \>\"", ",", " ", 
    RowBox[{"tray", " ", "/.", " ", 
     RowBox[{"t", " ", "->", " ", "4."}]}], ",", 
    " ", "\"\<, analitica {u0 t, a t^2/2} = \>\"", ",", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"u0", " ", "4"}], ",", " ", 
      RowBox[{"a", " ", 
       RowBox[{"16", "/", "2"}]}]}], "}"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"pendiente", "[", "t_", "]"}], " ", ":=", " ", 
    RowBox[{"a", " ", 
     RowBox[{"t", "/", "u0"}]}]}], ";"}], "                       ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "las", " ", "lineas", " ", "de", " ", "corriente", " ", "en", " ", "el", " ",
     "instante", " ", "t", " ", "son", " ", "rectas"}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<D: pendiente de las lineas de corriente en t = 2 s = \>\"", ",",
     " ", 
    RowBox[{"pendiente", "[", "2", "]"}], ",", 
    " ", "\"\<, de la trayectoria en ese instante = \>\"", ",", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"a", " ", 
       RowBox[{"t", "/", "u0"}]}], ")"}], " ", "/.", " ", 
     RowBox[{"t", " ", "->", " ", "2"}]}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"figD", " ", "=", " ", 
   RowBox[{"Show", "[", 
    RowBox[{
     RowBox[{"ParametricPlot", "[", 
      RowBox[{"tray", ",", " ", 
       RowBox[{"{", 
        RowBox[{"t", ",", " ", "0", ",", " ", "4"}], "}"}], ",", " ", 
       RowBox[{"PlotStyle", " ", "->", " ", "Blue"}]}], "]"}], ",", "\n", 
     "   ", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"pendiente", "[", "4", "]"}], " ", "xx"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"xx", ",", " ", "0", ",", " ", "8"}], "}"}], ",", " ", 
       RowBox[{"PlotStyle", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"Dashed", ",", " ", "Black"}], "}"}]}]}], "]"}], ",", "\n", 
     "   ", 
     RowBox[{"AxesLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<x (m)\>\"", ",", " ", "\"\<y (m)\>\""}], "}"}]}], ",", 
     " ", 
     RowBox[{"PlotRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "8"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "8"}], "}"}]}], "}"}]}], ",", " ", 
     RowBox[{"AspectRatio", " ", "->", " ", "0.6"}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "360"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Export", "[", 
   RowBox[{"\"\<figures/m03-trayectoria.png\>\"", ",", " ", 
    RowBox[{"Rasterize", "[", 
     RowBox[{"figD", ",", " ", 
      RowBox[{"Background", " ", "->", " ", "White"}], ",", " ", 
      RowBox[{"ImageResolution", " ", "->", " ", "72"}]}], "]"}]}], "]"}], 
  ";"}]}], "Input",ExpressionUUID->"9bc67486-c99d-48b9-a0c1-0af952c00794"]
},
