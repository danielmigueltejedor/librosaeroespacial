Cell["Bloque A: parametros y asignaciones", "Chapter",ExpressionUUID->"38110496-6a2c-4ee7-bf36-88aa6f751bdf"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"g0", " ", "=", " ", "9.80665"}], ";"}], "            ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"m", "/", 
     RowBox[{"s", "^", "2"}]}], ",", " ", 
    RowBox[{"gravedad", " ", "estandar"}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"R", " ", "=", " ", "287.05287"}], ";"}], "           ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"J", "/", 
     RowBox[{"(", 
      RowBox[{"kg", " ", "K"}], ")"}]}], ",", " ", 
    RowBox[{"constante", " ", "del", " ", "aire"}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"T0", " ", "=", " ", "288.15"}], ";", " ", 
   RowBox[{"p0", " ", "=", " ", "101325."}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "K", " ", "y", " ", "Pa", " ", "al", " ", "nivel", " ", "del", " ", 
    "mar"}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"lapse", " ", "=", " ", 
    RowBox[{"N", "[", 
     RowBox[{
      RowBox[{"-", "6.5"}], "/", "1000"}], "]"}]}], ";"}], "     ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"K", "/", 
     RowBox[{"m", ":", " ", 
      RowBox[{"-", "6"}]}]}], ",", 
    RowBox[{
    "5", " ", "K", " ", "por", " ", "km", " ", "en", " ", "la", " ", 
     "troposfera"}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"r1", " ", "=", " ", 
    RowBox[{"RandomReal", "[", "]"}]}], ";"}], "       ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Set", " ", 
     RowBox[{"(", "=", ")"}]}], ":", " ", 
    RowBox[{"se", " ", "evalua", " ", "una", " ", "vez"}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"r2", " ", ":=", " ", 
    RowBox[{"RandomReal", "[", "]"}]}], ";"}], "      ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"SetDelayed", " ", 
     RowBox[{"(", ":=", ")"}]}], ":", " ", 
    RowBox[{"se", " ", "evalua", " ", "en", " ", "cada", " ", "uso"}]}], " ", 
   "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<A: r1 dos veces = \>\"", ",", " ", 
    RowBox[{"{", 
     RowBox[{"r1", ",", " ", "r1"}], "}"}], ",", 
    " ", "\"\<  r2 dos veces distintas = \>\"", ",", " ", 
    RowBox[{"Unequal", "[", 
     RowBox[{"r2", ",", " ", "r2"}], "]"}]}], "]"}], ";"}]}], "Input",Expressi\
onUUID->"c4434094-8b28-448f-a43f-a0f4d7a000ae"],

Cell["Bloque B: funciones y calculo simbolico", "Chapter",ExpressionUUID->"b33c7f46-19e3-47af-8595-46c0e403ab66"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"temp", "[", "z_", "]"}], " ", ":=", " ", 
   RowBox[{"T0", " ", "+", " ", 
    RowBox[{"lapse", " ", "z"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"pres", "[", "z_", "]"}], " ", ":=", " ", 
   RowBox[{"p0", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"temp", "[", "z", "]"}], "/", "T0"}], ")"}], "^", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "g0"}], "/", 
       RowBox[{"(", 
        RowBox[{"lapse", " ", "R"}], ")"}]}], ")"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"dens", "[", "z_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"pres", "[", "z", "]"}], "/", 
    RowBox[{"(", 
     RowBox[{"R", " ", 
      RowBox[{"temp", "[", "z", "]"}]}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{"\"\<B: p(11000) = \>\"", ",", " ", 
     RowBox[{"pres", "[", "11000.", "]"}], ",", 
     " ", "\"\< Pa,  rho(11000) = \>\"", ",", " ", 
     RowBox[{"dens", "[", "11000.", "]"}], ",", " ", "\"\< kg/m^3\>\""}], 
    "]"}], ";"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"Comprobacion", ":", " ", 
    RowBox[{
    "la", " ", "presion", " ", "cumple", " ", "la", " ", "ecuacion", " ", 
     "de", " ", "la", " ", "hidrostatica", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
       "derivada", " ", "de", " ", "p", " ", "mas", " ", "rho", " ", "g"}], ",",
        " ", "nula"}], ")"}]}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"hydro", " ", "=", " ", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"pres", "[", "z", "]"}], ",", " ", "z"}], "]"}], " ", "+", 
      " ", 
      RowBox[{
       RowBox[{"dens", "[", "z", "]"}], " ", "g0"}]}], ",", " ", 
     RowBox[{"0", " ", "<", " ", "z", " ", "<", " ", "11000"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<B: dp/dz + rho g simplificado = \>\"", ",", " ", 
    RowBox[{"Chop", "[", "hydro", "]"}]}], "]"}], ";"}]}], "Input",ExpressionU\
UID->"440a9eb8-b47a-44d4-a2d8-4d746ef6ebb4"],

Cell["Bloque C: resolver e integrar", "Chapter",ExpressionUUID->"01f583c7-81a6-40e3-87f2-4b42e037bfc8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"zHalf", " ", "=", " ", 
   RowBox[{"z", " ", "/.", " ", 
    RowBox[{"FindRoot", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"pres", "[", "z", "]"}], " ", "==", " ", 
       RowBox[{"p0", "/", "2"}]}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"z", ",", " ", "5000"}], "}"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{"\"\<C: altitud con la mitad de la presion = \>\"", ",", " ", 
     "zHalf", ",", " ", "\"\< m\>\""}], "]"}], ";"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "Masa", " ", "de", " ", "aire", " ", "por", " ", "metro", " ", "cuadrado",
      " ", "entre", " ", "0", " ", "y", " ", "11", " ", "km"}], ",", " ", 
    RowBox[{"integrando", " ", "la", " ", "densidad"}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"mCol", " ", "=", " ", 
   RowBox[{"NIntegrate", "[", 
    RowBox[{
     RowBox[{"dens", "[", "z", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"z", ",", " ", "0", ",", " ", "11000"}], "}"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{"\"\<C: masa de la columna 0-11 km = \>\"", ",", " ", "mCol", ",",
      " ", "\"\< kg/m^2,  (p0 - p(11 km))/g0 = \>\"", ",", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"p0", " ", "-", " ", 
        RowBox[{"pres", "[", "11000.", "]"}]}], ")"}], "/", "g0"}]}], "]"}], 
   ";"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"Atmosfera", " ", 
    RowBox[{"isoterma", ":", " ", 
     RowBox[{"solucion", " ", "simbolica", " ", "con", " ", "DSolve"}]}]}], 
   " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"iso", " ", "=", " ", 
   RowBox[{"DSolveValue", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"pp", "'"}], "[", "z", "]"}], " ", "==", " ", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"pp", "[", "z", "]"}]}], " ", 
         RowBox[{"g0", "/", 
          RowBox[{"(", 
           RowBox[{"R", " ", "TT"}], ")"}]}]}]}], ",", " ", 
       RowBox[{
        RowBox[{"pp", "[", "0", "]"}], " ", "==", " ", "p0"}]}], "}"}], ",", 
     " ", 
     RowBox[{"pp", "[", "z", "]"}], ",", " ", "z"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<C: atmosfera isoterma p(z) = \>\"", ",", " ", "iso"}], "]"}], 
  ";"}]}], "Input",ExpressionUUID->"84397b7c-fe89-42ad-b115-6debaad1e719"],

Cell["Bloque D: graficos", "Chapter",ExpressionUUID->"e2e1f4a5-09b0-40a8-b860-0272b765e72f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"figD", " ", "=", " ", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"pres", "[", "z", "]"}], "/", "p0"}], ",", " ", 
       RowBox[{
        RowBox[{"dens", "[", "z", "]"}], "/", 
        RowBox[{"dens", "[", "0", "]"}]}], ",", " ", 
       RowBox[{
        RowBox[{"temp", "[", "z", "]"}], "/", "T0"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"z", ",", " ", "0", ",", " ", "11000"}], "}"}], ",", "\n", "  ", 
     RowBox[{"PlotLegends", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<p/p0\>\"", ",", " ", "\"\<rho/rho0\>\"", ",", 
        " ", "\"\<T/T0\>\""}], "}"}]}], ",", " ", 
     RowBox[{"AxesLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<z (m)\>\"", ",", " ", "None"}], "}"}]}], ",", "\n", "  ", 
     
     RowBox[{"PlotStyle", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"Black", ",", " ", "Blue", ",", " ", "Red"}], "}"}]}], ",", 
     " ", 
     RowBox[{"ImageSize", " ", "->", " ", "400"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Export", "[", 
   RowBox[{"\"\<figures/m01-atmosfera.png\>\"", ",", " ", 
    RowBox[{"Rasterize", "[", 
     RowBox[{"figD", ",", " ", 
      RowBox[{"Background", " ", "->", " ", "White"}], ",", " ", 
      RowBox[{"ImageResolution", " ", "->", " ", "96"}]}], "]"}]}], "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"figP", " ", "=", " ", 
   RowBox[{"ParametricPlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"pres", "[", "z", "]"}], "/", "1000"}], ",", " ", 
       RowBox[{"z", "/", "1000"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"z", ",", " ", "0", ",", " ", "11000"}], "}"}], ",", " ", 
     RowBox[{"AspectRatio", " ", "->", " ", "0.8"}], ",", "\n", "  ", 
     RowBox[{"AxesLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<p (kPa)\>\"", ",", " ", "\"\<z (km)\>\""}], "}"}]}], ",", 
     " ", 
     RowBox[{"PlotStyle", " ", "->", " ", "Blue"}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "300"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Export", "[", 
   RowBox[{"\"\<figures/m01-parametrico.png\>\"", ",", " ", 
    RowBox[{"Rasterize", "[", 
     RowBox[{"figP", ",", " ", 
      RowBox[{"Background", " ", "->", " ", "White"}], ",", " ", 
      RowBox[{"ImageResolution", " ", "->", " ", "96"}]}], "]"}]}], "]"}], 
  ";"}]}], "Input",ExpressionUUID->"56ab7411-cabc-4044-bd8e-75ca4f1e0844"],

Cell["Bloque E: exploracion interactiva (ejecutar en un cuaderno)", "Chapter",ExpressionUUID->"79d3a9a3-23c4-4338-8afc-753b2cf0797a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"explorar", " ", "=", " ", 
    RowBox[{"Manipulate", "[", "\n", "  ", 
     RowBox[{
      RowBox[{"Plot", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", " ", "+", " ", 
           RowBox[{"a", " ", 
            RowBox[{"z", "/", "T0"}]}]}], ")"}], "^", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "g0"}], "/", 
           RowBox[{"(", 
            RowBox[{"a", " ", "R"}], ")"}]}], ")"}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"z", ",", " ", "0", ",", " ", "11000"}], "}"}], ",", " ", 
        RowBox[{"PlotRange", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "1"}], "}"}]}], ",", "\n", "    ", 
        RowBox[{"AxesLabel", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"\"\<z (m)\>\"", ",", " ", "\"\<p/p0\>\""}], "}"}]}]}], 
       "]"}], ",", "\n", "  ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"a", ",", " ", 
          RowBox[{"-", "0.0065"}], ",", " ", "\"\<gradiente (K/m)\>\""}], 
         "}"}], ",", " ", 
        RowBox[{"-", "0.0098"}], ",", " ", 
        RowBox[{"-", "0.002"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"Verificacion", " ", "sin", " ", 
    RowBox[{"interfaz", ":", " ", 
     RowBox[{
     "el", " ", "cuerpo", " ", "del", " ", "Manipulate", " ", "en", " ", "un",
       " ", "valor", " ", "concreto", " ", "del", " ", "control"}]}]}], " ", 
   "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<E: p/p0 a 5 km con a = -0.0065: \>\"", ",", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", " ", "+", " ", 
       RowBox[{"lapse", " ", 
        RowBox[{"5000", "/", "T0"}]}]}], ")"}], "^", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "g0"}], "/", 
       RowBox[{"(", 
        RowBox[{"lapse", " ", "R"}], ")"}]}], ")"}]}], ",", 
    " ", "\"\< ; con a = -0.0098: \>\"", ",", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", " ", "-", " ", 
       RowBox[{"0.0098", " ", 
        RowBox[{"5000", "/", "T0"}]}]}], ")"}], "^", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "g0"}], "/", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "0.0098"}], " ", "R"}], ")"}]}], ")"}]}]}], "]"}], 
  ";"}]}], "Input",ExpressionUUID->"ca5dd349-6bf7-4fd6-b417-422b6401245b"]
},
