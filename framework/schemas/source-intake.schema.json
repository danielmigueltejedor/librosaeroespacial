{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aerobooks.local/schemas/source-intake.schema.json",
  "title": "AeroBooks local source intake inventory",
  "type": "object",
  "required": ["schema_version", "book", "source_directory_name", "files"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "book": {"type": "string"},
    "source_directory_name": {"type": "string"},
    "warning": {"type": "string"},
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "filename", "relative_path", "extension", "bytes",
          "sha256", "classification"
        ],
        "properties": {
          "filename": {"type": "string"},
          "relative_path": {"type": "string"},
          "extension": {"type": "string"},
          "bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "classification": {"enum": ["pending", "accepted", "rejected"]},
          "notes": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
