{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aerobooks.local/schemas/exercise.schema.json",
  "title": "Solved exercise ledger entry",
  "type": "object",
  "required": [
    "id",
    "statement",
    "origin",
    "data",
    "unknowns",
    "hypotheses",
    "solution",
    "result",
    "units",
    "checks",
    "reviewer",
    "status"
  ],
  "properties": {
    "id": {"type": "string"},
    "statement": {"type": "string"},
    "origin": {"const": "aerobooks"},
    "data": {"type": "object"},
    "unknowns": {"type": "array"},
    "hypotheses": {"type": "array", "items": {"type": "string"}},
    "solution": {"type": "string"},
    "result": {"type": "string"},
    "units": {"type": "string"},
    "numerical_tolerance": {"type": ["number", "null"]},
    "checks": {"type": "array"},
    "reviewer": {"type": "string"},
    "status": {"enum": ["draft", "solved", "published", "rejected"]},
    "reviews": {
      "type": "object",
      "properties": {
        "mathematical": {"type": "string"},
        "units": {"type": "string"},
        "independent_solution": {"type": "string"},
        "computational": {"type": "string"}
      }
    },
    "computational": {"type": "object"},
    "verification": {
      "type": "object",
      "description": "Contrato 0.4. El framework vuelve a ejecutar la solución; no acepta un visto bueno.",
      "properties": {
        "author": {"type": "object"},
        "independent": {"type": "object"},
        "defines": {"type": "string"},
        "original_equation": {"type": "string"},
        "quantities": {"type": "object"},
        "bindings_range": {"type": "object"},
        "limit_cases": {"type": "array"},
        "parametric_cases": {"const": 100},
        "seed": {"type": "integer"},
        "tolerance": {"type": "number"},
        "sources": {"type": "array", "items": {"type": "string"}},
        "equations": {"type": "array", "items": {"type": "string"}},
        "dependency_lock": {"type": "object"}
      }
    }
  }
}
