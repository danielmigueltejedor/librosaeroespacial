{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aerobooks.local/schemas/review-report.schema.json",
  "title": "AeroBooks AI review report",
  "type": "object",
  "required": ["review_type", "book", "status", "checked", "findings"],
  "properties": {
    "review_type": {"type": "string"},
    "book": {"type": "string"},
    "status": {"enum": ["pass", "pass_with_changes", "fail"]},
    "checked": {"type": "array", "items": {"type": "string"}},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "claim_or_location", "issue", "action"],
        "properties": {
          "severity": {"enum": ["info", "warning", "error", "blocker"]},
          "claim_or_location": {"type": "string"},
          "issue": {"type": "string"},
          "evidence": {"type": ["string", "null"]},
          "action": {"type": "string"}
        }
      }
    }
  }
}
