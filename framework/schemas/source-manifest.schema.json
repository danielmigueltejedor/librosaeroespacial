{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aerobooks.local/schemas/source-manifest.schema.json",
  "title": "AeroBooks Source Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "book",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "book": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "kind",
          "tier",
          "role",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "tier": {
            "enum": [
              "A",
              "B",
              "C",
              "D",
              "E"
            ]
          },
          "role": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "enum": [
              "verified",
              "provided",
              "pending",
              "rejected"
            ]
          },
          "citation_key": {
            "type": [
              "string",
              "null"
            ]
          },
          "locator": {
            "type": [
              "string",
              "null"
            ]
          },
          "rights": {
            "type": [
              "string",
              "null"
            ]
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          },
          "authors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "published": {
            "type": [
              "string",
              "null"
            ]
          },
          "edition": {
            "type": [
              "string",
              "null"
            ]
          },
          "accessed": {
            "type": [
              "string",
              "null"
            ]
          },
          "checksum_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "license": {
            "type": [
              "string",
              "null"
            ]
          },
          "open_access": {
            "type": "boolean"
          },
          "tier_detail": {
            "enum": ["A0", "A1", "A2", "A3", "B0", "B1", "B2", "C0", "C1", "D0", "D1", "D2", "E"]
          },
          "lifecycle": {
            "enum": ["candidate", "accepted", "rejected"]
          },
          "content_access": {
            "enum": ["full", "snippet", "metadata-only"]
          },
          "consulted": {"type": "boolean"},
          "doi": {"type": ["string", "null"]},
          "doi_verified": {"type": "boolean"},
          "doi_check_method": {"type": ["string", "null"]},
          "isbn": {"type": ["string", "null"]},
          "isbn_verified": {"type": "boolean"},
          "peer_reviewed": {"type": "boolean"},
          "peer_review_status": {"type": ["string", "null"]},
          "publisher": {"type": ["string", "null"]},
          "origin_id": {"type": ["string", "null"]},
          "derived_from": {"type": "array", "items": {"type": "string"}},
          "discovered_from": {"type": ["string", "null"]},
          "discovery_log": {"type": ["string", "null"]},
          "metadata_origin": {"enum": ["declared", "verified", "invented"]},
          "direct_relevance": {"type": ["integer", "null"]},
          "relevance_reason": {"type": ["string", "null"]},
          "currency_relevant": {"type": "boolean"},
          "copyright_status": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    }
  }
}
